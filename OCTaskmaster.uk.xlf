<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en-US" target-language="uk" original="../TASKMASTERLIBRARY/OCTASKMASTER/PROPERTIES/RESOURCES.RESX">
    <body>
      <group id="../TASKMASTERLIBRARY/OCTASKMASTER/PROPERTIES/RESOURCES.RESX" datatype="resx">
        <trans-unit id="About" translate="yes" xml:space="preserve">
          <source>About</source>
          <target state="new">Про програму</target>
        </trans-unit>
        <trans-unit id="AutoScrollJobs" translate="yes" xml:space="preserve">
          <source>Auto-scroll jobs</source>
          <target state="new">Автоматична прокрутка</target>
        </trans-unit>
        <trans-unit id="AutoScrollPaused" translate="yes" xml:space="preserve">
          <source>Cursor inside. Auto-scroll paused</source>
          <target state="new">Курсор всередині. Автопрокрутка зупинилася</target>
        </trans-unit>
        <trans-unit id="AutoScrollTasks" translate="yes" xml:space="preserve">
          <source>Auto-scroll job's tasks</source>
          <target state="new">Завдання автопрокрутки роботи</target>
        </trans-unit>
        <trans-unit id="BTN_Cancel" translate="yes" xml:space="preserve">
          <source>Cancel</source>
          <target state="new">Скасувати</target>
        </trans-unit>
        <trans-unit id="BTN_CancelAll" translate="yes" xml:space="preserve">
          <source>Cancel all</source>
          <target state="new">Скасувати все</target>
        </trans-unit>
