          <source>Overwrite</source>
          <target state="new">Перезаписати</target>
        </trans-unit>
        <trans-unit id="BTN_OverwriteAll" translate="yes" xml:space="preserve">
          <source>Overwrite all</source>
          <target state="new">Перезаписати все</target>
        </trans-unit>
        <trans-unit id="BTN_OverwriteAllOlder" translate="yes" xml:space="preserve">
          <source>Overwrite all older</source>
          <target state="new">Перезаписати все старіше</target>
        </trans-unit>
        <trans-unit id="BTN_Rename" translate="yes" xml:space="preserve">
          <source>Rename</source>
          <target state="new">Перейменувати</target>
        </trans-unit>
        <trans-unit id="BTN_RenameAll" translate="yes" xml:space="preserve">
          <source>Rename all</source>
          <target state="new">Перейменувати все</target>
        </trans-unit>
