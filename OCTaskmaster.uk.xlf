          <source>Item already exists</source>
          <target state="new">Товар вже існує</target>
        </trans-unit>
        <trans-unit id="MSG_SkippedSame" translate="yes" xml:space="preserve">
          <source>Item already exists - same date</source>
          <target state="new">Товар уже існує - та сама дата</target>
        </trans-unit>
