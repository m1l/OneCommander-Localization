          <target state="new">Прогрес даних</target>
        </trans-unit>
        <trans-unit id="Destination" translate="yes" xml:space="preserve">
          <source>To</source>
          <target state="new">до</target>
        </trans-unit>
        <trans-unit id="EstimatedTimeRemainingHours" translate="yes" xml:space="preserve">
          <source>~{0} hours</source>
          <target state="new">~{0} годин</target>
          <note from="MultilingualBuild">Estimated time remaining when six or more hours remain</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingHoursMinutes" translate="yes" xml:space="preserve">
          <source>~{0} h {1} min</source>
          <target state="new">~{0} год {1} хв</target>
          <note from="MultilingualBuild">Estimated time remaining when at least one hour but less than six hours remain</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingMinutesSeconds" translate="yes" xml:space="preserve">
          <source>~{0} min {1} s</source>
          <target state="new">~{0} хв {1} с</target>
          <note from="MultilingualBuild">Estimated time remaining when at least one minute but less than one hour remains</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingSeconds" translate="yes" xml:space="preserve">
          <source>~{0} s</source>
          <target state="new">~{0} s</target>
          <note from="MultilingualBuild">Estimated time remaining when less than one minute remains</note></trans-unit>
