          <target state="new">درباره</target>
        </trans-unit>
        <trans-unit id="AutoScrollJobs" translate="yes" xml:space="preserve">
          <source>Auto-scroll jobs</source>
          <target state="new">اسکرول خودکار</target>
        </trans-unit>
