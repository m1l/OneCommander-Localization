<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en-US" target-language="ko" original="../TASKMASTERLIBRARY/OCTASKMASTER/PROPERTIES/RESOURCES.RESX">
    <body>
      <group id="../TASKMASTERLIBRARY/OCTASKMASTER/PROPERTIES/RESOURCES.RESX" datatype="resx">
        <trans-unit id="About" translate="yes" xml:space="preserve">
          <source>About</source>
          <target state="translated">정보</target>
        </trans-unit>
        <trans-unit id="AutoScrollJobs" translate="yes" xml:space="preserve">
          <source>Auto-scroll jobs</source>
          <target state="translated">작업 목록 자동 스크롤</target>
        </trans-unit>
        <trans-unit id="AutoScrollPaused" translate="yes" xml:space="preserve">
          <source>Cursor inside. Auto-scroll paused</source>
          <target state="translated">포인터가 목록 위에 있어 자동 스크롤을 일시 정지했습니다.</target>
        </trans-unit>
        <trans-unit id="AutoScrollTasks" translate="yes" xml:space="preserve">
          <source>Auto-scroll job's tasks</source>
          <target state="translated">세부 작업 목록 자동 스크롤</target>
        </trans-unit>
        <trans-unit id="BTN_Cancel" translate="yes" xml:space="preserve">
          <source>Cancel</source>
          <target state="translated">취소</target>
        </trans-unit>
        <trans-unit id="BTN_CancelAll" translate="yes" xml:space="preserve">
          <source>Cancel all</source>
          <target state="translated">모두 취소</target>
        </trans-unit>
        <trans-unit id="BTN_Overwrite" translate="yes" xml:space="preserve">
          <source>Overwrite</source>
          <target state="translated">덮어쓰기</target>
        </trans-unit>
        <trans-unit id="BTN_OverwriteAll" translate="yes" xml:space="preserve">
          <source>Overwrite all</source>
          <target state="translated">모두 덮어쓰기</target>
        </trans-unit>
        <trans-unit id="BTN_OverwriteAllOlder" translate="yes" xml:space="preserve">
          <source>Overwrite all older</source>
          <target state="translated">더 오래된 항목만 덮어쓰기</target>
        </trans-unit>
        <trans-unit id="BTN_Rename" translate="yes" xml:space="preserve">
          <source>Rename</source>
          <target state="translated">이름 바꾸기</target>
        </trans-unit>
        <trans-unit id="BTN_RenameAll" translate="yes" xml:space="preserve">
          <source>Rename all</source>
          <target state="translated">모두 이름 바꾸기</target>
        </trans-unit>
        <trans-unit id="BTN_Skip" translate="yes" xml:space="preserve">
          <source>Skip</source>
          <target state="translated">건너뛰기</target>
        </trans-unit>
        <trans-unit id="BTN_SkipAll" translate="yes" xml:space="preserve">
          <source>Skip all</source>
          <target state="translated">모두 건너뛰기</target>
        </trans-unit>
        <trans-unit id="ClearCompleted" translate="yes" xml:space="preserve">
          <source>Clear completed</source>
          <target state="translated">완료 항목 지우기</target>
        </trans-unit>
        <trans-unit id="ClearCompletedJobs_TT" translate="yes" xml:space="preserve">
          <source>Clear completed jobs</source>
          <target state="translated">완료된 작업 지우기</target>
        </trans-unit>
        <trans-unit id="CloseOnComplete" translate="yes" xml:space="preserve">
          <source>Close on complete</source>
          <target state="translated">완료되면 닫기</target>
        </trans-unit>
        <trans-unit id="ConcurrentJobs" translate="yes" xml:space="preserve">
          <source>Concurrent jobs</source>
          <target state="translated">동시 작업</target>
        </trans-unit>
        <trans-unit id="ConflictResolution" translate="yes" xml:space="preserve">
          <source>Conflict resolution</source>
          <target state="translated">충돌 처리</target>
        </trans-unit>
        <trans-unit id="DataProgress" translate="yes" xml:space="preserve">
          <source>Data progress</source>
          <target state="translated">데이터 진행률</target>
        </trans-unit>
        <trans-unit id="Destination" translate="yes" xml:space="preserve">
          <source>To</source>
          <target state="translated">대상</target>
        </trans-unit>
        <trans-unit id="EstimatedTimeRemainingHours" translate="yes" xml:space="preserve">
          <source>~{0} hours</source>
          <target state="translated">약 {0}시간</target>
          <note from="MultilingualBuild">Estimated time remaining when six or more hours remain</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingHoursMinutes" translate="yes" xml:space="preserve">
          <source>~{0} h {1} min</source>
          <target state="translated">약 {0}시간 {1}분</target>
          <note from="MultilingualBuild">Estimated time remaining when at least one hour but less than six hours remain</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingMinutesSeconds" translate="yes" xml:space="preserve">
          <source>~{0} min {1} s</source>
          <target state="translated">약 {0}분 {1}초</target>
          <note from="MultilingualBuild">Estimated time remaining when at least one minute but less than one hour remains</note></trans-unit>
        <trans-unit id="EstimatedTimeRemainingSeconds" translate="yes" xml:space="preserve">
          <source>~{0} s</source>
          <target state="translated">약 {0}초</target>
          <note from="MultilingualBuild">Estimated time remaining when less than one minute remains</note></trans-unit>
        <trans-unit id="FileFullName" translate="yes" xml:space="preserve">
          <source>Full name</source>
          <target state="translated">원본 전체 경로</target>
        </trans-unit>
        <trans-unit id="FileFullNameFinal" translate="yes" xml:space="preserve">
          <source>Full name final</source>
          <target state="translated">작업 후 전체 경로</target>
        </trans-unit>
        <trans-unit id="FileName" translate="yes" xml:space="preserve">
          <source>Name</source>
          <target state="translated">이름</target>
        </trans-unit>
        <trans-unit id="FileOperation" translate="yes" xml:space="preserve">
          <source>Operation</source>
          <target state="translated">작업 유형</target>
        </trans-unit>
        <trans-unit id="FileSize" translate="yes" xml:space="preserve">
          <source>Size</source>
          <target state="translated">크기</target>
        </trans-unit>
        <trans-unit id="FilesProgress" translate="yes" xml:space="preserve">
          <source>Files progress</source>
          <target state="translated">파일 진행률</target>
        </trans-unit>
        <trans-unit id="HideOnClose" translate="yes" xml:space="preserve">
          <source>Hide on close</source>
          <target state="translated">닫을 때 창 숨기기</target>
        </trans-unit>
        <trans-unit id="JobName" translate="yes" xml:space="preserve">
          <source>Job</source>
          <target state="translated">작업</target>
        </trans-unit>
        <trans-unit id="JobNameMultipleItems" translate="yes" xml:space="preserve">
          <source>{0} items</source>
          <target state="translated">항목 {0}개</target>
        </trans-unit>
        <trans-unit id="JobsCompleted" translate="yes" xml:space="preserve">
          <source>Jobs completed</source>
          <target state="translated">완료된 작업</target>
          <note from="MultilingualBuild">Tooltip</note></trans-unit>
        <trans-unit id="JobsFailed" translate="yes" xml:space="preserve">
          <source>Jobs failed</source>
          <target state="translated">실패한 작업</target>
          <note from="MultilingualBuild">Tooltip</note></trans-unit>
        <trans-unit id="JobsPending" translate="yes" xml:space="preserve">
          <source>Jobs pending</source>
          <target state="translated">대기 중인 작업</target>
          <note from="MultilingualBuild">Tooltip</note></trans-unit>
        <trans-unit id="KeepFileDates" translate="yes" xml:space="preserve">
          <source>Keep file dates</source>
          <target state="translated">파일 날짜 유지</target>
        </trans-unit>
        <trans-unit id="MSG_DelegatedToExplorer" translate="yes" xml:space="preserve">
          <source>Delegated to Explorer due to error:</source>
          <target state="translated">오류가 발생해 파일 탐색기에서 처리합니다:</target>
          <note from="MultilingualBuild">Error when permissions are lacking so Explorer can elevate and handle it</note></trans-unit>
        <trans-unit id="MSG_DoesNotExist" translate="yes" xml:space="preserve">
          <source>Doesn't exist</source>
          <target state="translated">존재하지 않습니다.</target>
        </trans-unit>
        <trans-unit id="MSG_ErrorDirectoryExists" translate="yes" xml:space="preserve">
          <source>Folder with this name already exists</source>
          <target state="translated">이 이름의 폴더가 이미 있습니다.</target>
        </trans-unit>
        <trans-unit id="MSG_ErrorFileExists" translate="yes" xml:space="preserve">
          <source>File with this name already exists</source>
          <target state="translated">이 이름의 파일이 이미 있습니다.</target>
        </trans-unit>
        <trans-unit id="MSG_ExplorerError" translate="yes" xml:space="preserve">
          <source>Explorer reported error</source>
          <target state="translated">파일 탐색기에서 오류가 발생했습니다.</target>
          <note from="MultilingualBuild">If Windows File Explorer fails this message is shown</note></trans-unit>
        <trans-unit id="MSG_HandledByExplorer" translate="yes" xml:space="preserve">
          <source>Handled by Explorer</source>
          <target state="translated">파일 탐색기에서 처리했습니다.</target>
          <note from="MultilingualBuild">If operation is delegated to File Explorer, then this is message on success</note></trans-unit>
        <trans-unit id="MSG_SkippedExists" translate="yes" xml:space="preserve">
          <source>Item already exists</source>
          <target state="translated">항목이 이미 있습니다.</target>
        </trans-unit>
        <trans-unit id="MSG_SkippedSame" translate="yes" xml:space="preserve">
          <source>Item already exists - same date</source>
          <target state="translated">항목이 이미 있으며 날짜가 같습니다.</target>
        </trans-unit>
        <trans-unit id="OperationCopy" translate="yes" xml:space="preserve">
          <source>Copy</source>
          <target state="translated">복사</target>
        </trans-unit>
        <trans-unit id="OperationCreateDir" translate="yes" xml:space="preserve">
          <source>Create folder</source>
          <target state="translated">폴더 만들기</target>
        </trans-unit>
        <trans-unit id="OperationDeletePerm" translate="yes" xml:space="preserve">
          <source>Delete</source>
          <target state="translated">영구 삭제</target>
        </trans-unit>
        <trans-unit id="OperationMove" translate="yes" xml:space="preserve">
          <source>Move</source>
          <target state="translated">이동</target>
        </trans-unit>
        <trans-unit id="OperationRecycle" translate="yes" xml:space="preserve">
          <source>Recycle</source>
          <target state="translated">휴지통으로 이동</target>
        </trans-unit>
        <trans-unit id="OperationRename" translate="yes" xml:space="preserve">
          <source>Rename</source>
          <target state="translated">이름 바꾸기</target>
        </trans-unit>
        <trans-unit id="OperationReverse" translate="yes" xml:space="preserve">
          <source>Reverse job</source>
          <target state="translated">작업 되돌리기</target>
        </trans-unit>
        <trans-unit id="Option_Ask" translate="yes" xml:space="preserve">
          <source>Ask/Prompt</source>
          <target state="translated">매번 묻기</target>
        </trans-unit>
        <trans-unit id="Pause" translate="yes" xml:space="preserve">
          <source>Pause</source>
          <target state="translated">일시 정지</target>
        </trans-unit>
        <trans-unit id="PercentDone" translate="yes" xml:space="preserve">
          <source>Progress</source>
          <target state="translated">진행률</target>
        </trans-unit>
        <trans-unit id="ResRenamed" translate="yes" xml:space="preserve">
          <source>Renamed</source>
          <target state="translated">이름 바꿈</target>
        </trans-unit>
        <trans-unit id="ResReplaced" translate="yes" xml:space="preserve">
          <source>Replaced</source>
          <target state="translated">덮어씀</target>
        </trans-unit>
        <trans-unit id="ResSkipped" translate="yes" xml:space="preserve">
          <source>Skipped</source>
          <target state="translated">건너뜀</target>
        </trans-unit>
        <trans-unit id="Res_Completed" translate="yes" xml:space="preserve">
          <source>Completed</source>
          <target state="translated">완료</target>
        </trans-unit>
        <trans-unit id="Res_Enumerating" translate="yes" xml:space="preserve">
          <source>Retrieving files</source>
          <target state="translated">파일 목록을 가져오는 중</target>
        </trans-unit>
        <trans-unit id="Res_Failed" translate="yes" xml:space="preserve">
          <source>Failed</source>
          <target state="translated">실패</target>
        </trans-unit>
        <trans-unit id="Res_Processing" translate="yes" xml:space="preserve">
          <source>Processing</source>
          <target state="translated">처리 중</target>
        </trans-unit>
        <trans-unit id="Res_Queued" translate="yes" xml:space="preserve">
          <source>Queued</source>
          <target state="translated">대기 중</target>
        </trans-unit>
        <trans-unit id="Res_Stopped" translate="yes" xml:space="preserve">
          <source>Stopped/Cancelled</source>
          <target state="translated">중지 / 취소됨</target>
        </trans-unit>
        <trans-unit id="ResetToDefault" translate="yes" xml:space="preserve">
          <source>Reset to default</source>
          <target state="translated">기본값으로 재설정</target>
        </trans-unit>
        <trans-unit id="SizeMB" translate="yes" xml:space="preserve">
          <source>MB</source>
          <target state="translated">MB</target>
        </trans-unit>
        <trans-unit id="SizeMiB" translate="yes" xml:space="preserve">
          <source>MiB</source>
          <target state="translated">MiB</target>
        </trans-unit>
        <trans-unit id="Source" translate="yes" xml:space="preserve">
          <source>From</source>
          <target state="translated">원본</target>
        </trans-unit>
        <trans-unit id="Status" translate="yes" xml:space="preserve">
          <source>Status</source>
          <target state="translated">상태</target>
        </trans-unit>
        <trans-unit id="TXT_Conflict" translate="yes" xml:space="preserve">
          <source>Conflict</source>
          <target state="translated">충돌</target>
        </trans-unit>
        <trans-unit id="TaskMessage" translate="yes" xml:space="preserve">
          <source>Message</source>
          <target state="translated">메시지</target>
        </trans-unit>
        <trans-unit id="TimeRemaining" translate="yes" xml:space="preserve">
          <source>Time remaining</source>
          <target state="translated">남은 시간</target>
        </trans-unit>
        <trans-unit id="TotalTime" translate="yes" xml:space="preserve">
          <source>Total time</source>
          <target state="translated">전체 시간</target>
        </trans-unit>
        <trans-unit id="TransferRate" translate="yes" xml:space="preserve">
          <source>Transfer rate</source>
          <target state="translated">전송 속도</target>
        </trans-unit>
      </group>
    </body>
  </file>
</xliff>