          <source>Keep file dates</source>
          <target state="new">ファイルの日付を保持する</target>
        </trans-unit>
        <trans-unit id="MSG_DelegatedToExplorer" translate="yes" xml:space="preserve">
          <source>Delegated to Explorer due to error:</source>
          <target state="new">エラーのためエクスプローラーに委任されました:</target>
          <note from="MultilingualBuild">Error when permissions are lacking so Explorer can elevate and handle it</note></trans-unit>
        <trans-unit id="MSG_DoesNotExist" translate="yes" xml:space="preserve">
          <source>Doesn't exist</source>
          <target state="new">存在しません</target>
        </trans-unit>
        <trans-unit id="MSG_ErrorDirectoryExists" translate="yes" xml:space="preserve">
          <source>Folder with this name already exists</source>
          <target state="new">この名前のフォルダは既に存在します</target>
        </trans-unit>
        <trans-unit id="MSG_ErrorFileExists" translate="yes" xml:space="preserve">
          <source>File with this name already exists</source>
          <target state="new">この名前のファイルはすでに存在します</target>
        </trans-unit>
        <trans-unit id="MSG_ExplorerError" translate="yes" xml:space="preserve">
          <source>Explorer reported error</source>
          <target state="new">エクスプローラーがエラーを報告しました</target>
          <note from="MultilingualBuild">If Windows File Explorer fails this message is shown</note></trans-unit>
        <trans-unit id="MSG_HandledByExplorer" translate="yes" xml:space="preserve">
          <source>Handled by Explorer</source>
          <target state="new">エクスプローラーによって処理されます</target>
          <note from="MultilingualBuild">If operation is delegated to File Explorer, then this is message on success</note></trans-unit>
        <trans-unit id="MSG_SkippedExists" translate="yes" xml:space="preserve">
          <source>Item already exists</source>
          <target state="new">項目はすでに存在します</target>
        </trans-unit>
        <trans-unit id="MSG_SkippedSame" translate="yes" xml:space="preserve">
          <source>Item already exists - same date</source>
          <target state="new">アイテムはすでに存在します - 同じ日付</target>
        </trans-unit>
