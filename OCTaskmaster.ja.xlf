          <source>Jobs failed</source>
          <target state="new">ジョブが失敗しました</target>
          <note from="MultilingualBuild">Tooltip</note></trans-unit>
        <trans-unit id="JobsPending" translate="yes" xml:space="preserve">
          <source>Jobs pending</source>
          <target state="new">保留中のジョブ</target>
          <note from="MultilingualBuild">Tooltip</note></trans-unit>
