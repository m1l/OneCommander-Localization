          <source>Message</source>
          <target state="new">メッセージ</target>
        </trans-unit>
        <trans-unit id="TimeRemaining" translate="yes" xml:space="preserve">
          <source>Time remaining</source>
          <target state="new">残り時間</target>
        </trans-unit>
        <trans-unit id="TotalTime" translate="yes" xml:space="preserve">
          <source>Total time</source>
          <target state="new">総時間</target>
        </trans-unit>
        <trans-unit id="TransferRate" translate="yes" xml:space="preserve">
          <source>Transfer rate</source>
          <target state="new">転送率</target>
        </trans-unit>
