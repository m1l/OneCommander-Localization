          <source>Create folder</source>
          <target state="new">フォルダーの作成</target>
        </trans-unit>
        <trans-unit id="OperationDeletePerm" translate="yes" xml:space="preserve">
          <source>Delete</source>
          <target state="new">消去</target>
        </trans-unit>
