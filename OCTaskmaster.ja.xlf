          <source>Failed</source>
          <target state="new">失敗した</target>
        </trans-unit>
        <trans-unit id="Res_Processing" translate="yes" xml:space="preserve">
          <source>Processing</source>
          <target state="new">処理</target>
        </trans-unit>
        <trans-unit id="Res_Queued" translate="yes" xml:space="preserve">
          <source>Queued</source>
          <target state="new">キューに入れられました</target>
        </trans-unit>
        <trans-unit id="Res_Stopped" translate="yes" xml:space="preserve">
          <source>Stopped/Cancelled</source>
          <target state="new">停止・中止</target>
        </trans-unit>
