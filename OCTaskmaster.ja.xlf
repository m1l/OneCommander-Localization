          <source>Job</source>
          <target state="new">職務</target>
        </trans-unit>
        <trans-unit id="JobNameMultipleItems" translate="yes" xml:space="preserve">
          <source>{0} items</source>
          <target state="new">{0} 個のアイテム</target>
        </trans-unit>
