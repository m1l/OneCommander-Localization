          <source>Full name</source>
          <target state="new">フルネーム</target>
        </trans-unit>
        <trans-unit id="FileFullNameFinal" translate="yes" xml:space="preserve">
          <source>Full name final</source>
          <target state="new">フルネーム最終決定</target>
        </trans-unit>
